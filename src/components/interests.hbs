{{> components/hr.hbs size="md" etc="auto-break-before do-break-before" }}
{{#if interests.length}}
  <section class="section no-break-inside no-break-after">
    <header class="section-header">
      <h2 class='section-title grid-column-flow'>
        <span class="icon {{ ICO "interest" }}"></span>
        {{ TITLE "interests" }}
      </h2>
    </header>
    <section id="interests" class="grid-3col">
      {{#each interests}}
        <div class="item card card-small">
        <h3 class="w-max text-title-font">{{ name }}</h3>
          {{#if keywords.length}}
            <ul class="keywords grid small">
              {{#each keywords}}
                <li>
                  {{.}}
                </li>
              {{/each}}
            </ul>
          {{/if}}
          {{#if summary}}
            <div class="summary">{{ summary }}</div>
          {{/if}}
        </div>
      {{/each}}
    </section>
  </section>
{{/if}}
