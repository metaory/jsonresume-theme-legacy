<button id='scheme-toggle'>
  <object class="light-icon" type="image/svg+xml" data="/src/assets/scheme/light.svg"></object>
  <object class="dark-icon" type="image/svg+xml" data="/src/assets/scheme/dark.svg"></object>
</button>

<script>
  const html = document.documentElement
  const prefersDark = matchMedia('(prefers-color-scheme: dark)').matches
  const lightIcon = document.querySelector('.light-icon')
  const darkIcon = document.querySelector('.dark-icon')


  if (prefersDark) {
    html.classList.add('dark')
    lightIcon.style.display = 'none'
    darkIcon.style.display = 'block'
  } else {
    lightIcon.style.display = 'block'
    darkIcon.style.display = 'none'
  }


  document.getElementById('scheme-toggle').addEventListener('click', () => {
    const isDark = html.classList.toggle('dark')
    if (isDark) {
      lightIcon.style.display = 'none'
      darkIcon.style.display = 'block'
      darkIcon.data = darkIcon.data
    } else {
      lightIcon.style.display = 'block'
      darkIcon.style.display = 'none'
      lightIcon.data = lightIcon.data
    }
  })
</script>
