{{#if publications.length}}
  {{> components/hr.hbs size="md" }}
  <section class="section">
    <header class="section-header">
      <h2 class='section-title grid-column-flow'>
        <span class="icon {{ ICO "article" }}"></span>
        {{ TITLE "publications" }}
      </h2>
    </header>
    <section id="publications">
      {{#each publications}}
        <section class="publication-item">
          <header class="item-header">
            {{#if publisher}}
              <span class="url publisher">
                <span class="icon {{ ICO "security" }}"></span>
                <a target="_blank" href="{{ url }}">
                  <span class="name text-title-font">{{ name }}</span>
                </a>
              </span>
            {{/if}}
            {{#if releaseDate}}
              <span class="date">{{ DMY releaseDate }}</span>
            {{/if}}
          </header>
          {{#if keywords.length}}
            <ul class="keywords">
              {{#each keywords}}
                <li>{{.}}</li>
              {{/each}}
            </ul>
          {{/if}}
          <div class="item">
            {{#if summary}}
              <div class="summary">{{{ summary }}}</div>
            {{/if}}
          </div>
        </section>
      {{/each}}
    </section>
  </section>
{{/if}}
