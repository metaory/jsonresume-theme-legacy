{{> components/hr.hbs size="md" etc="auto-break-before auto-break-after" }}
{{#if skills.length}}
  <section class="section">
    <header class="section-header">
      <h2 class="section-title grid-column-flow">
        <span class="icon {{ ICO "skills" }}"></span>
        {{ TITLE "skills" }}
      </h2>
    </header>
    <section id="skills" class="grid-3col">
      {{#each skills}}
        <div class="item card">
          {{#if name}}
            <h3 class="name font-bungee">{{ name }}</h3>
          {{/if}}
          {{#if level}}
            <div class="level {{ level }}">
              {{#if levelDisplay}}
                <em>{{ levelDisplay }}</em>
              {{ else }}
                <em>{{ level }}</em>
              {{/if}}
              <div class="bar"></div>
            </div>
          {{/if}}
          {{#if keywords.length}}
            <ul class="keywords">
              {{#each keywords}}
                <li>{{.}}</li>
              {{/each}}
            </ul>
          {{/if}}
        </div>
      {{/each}}
    </section>
  </section>
{{/if}}
