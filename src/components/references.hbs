{{#if references.length}}
  {{> components/hr.hbs size="md" }}
  <section class="section">
    <header class="section-header">
      <h2 class='section-title grid-column-flow'>
        <span class="icon {{ ICO "reference" }}"></span>
        {{ TITLE "references" }}
      </h2>
    </header>
    <section id="references" class="blur-card">
      {{#each references}}
        <div class="item">
          {{#if reference}}
            <blockquote class="reference">
              &#8220;&#32;{{ reference }}&#32;&#8221;
            </blockquote>
          {{/if}}
          {{#if name}}
            <div class="name text-title-font">{{ name }}</div>
          {{/if}}
        </div>
      {{/each}}
    </section>
  </section>
{{/if}}
