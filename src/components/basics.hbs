{{#basics}}
<article id="header">
  <h1 class="name">
    {{ name }}
    <span class="image">
      <img src="{{ logo }}">
    </span>
  </h1>
  <div class="label">
    <span>
      <img src="{{ image }}" class="m-auto">
    </span>
    <h2>{{{ label }}}</h2>
  </div>
    <section class="section contacts">
    {{#location}}
    <div class="location grid-column-flow">
      {{#if residency}}
        <span class="url w-max">
          <span class="icon {{ ICO "residency" }}"></span>
          {{ residency }}
        </span>
      {{/if}}
      <span class="url grid-column-flow">
        <span class="icon {{ ICO "location" }}"></span>
        {{#if address}}
          <span class="address">{{ address }},</span>
        {{/if}}
        {{#if postalCode}}
          <span class="postalCode">{{ postalCode }},</span>
        {{/if}}
        {{#if city}}
          <span class="city">{{ city }}</span>
        {{/if}}
        {{#if region}}
          · <span class="region">{{ region }}</span>
        {{/if}}
        {{#if countryCode}}
          · <span class="countryCode">{{ countryCode }}</span>
        {{/if}}
      </span>
    </div>
    {{/location}}
    {{#if birth}}
      {{ birth }}
    {{/if}}
    <div id="contact" class="grid-column-flow m-auto">
      {{#if url}}
        <span class="url grid-column-flow">
          <span class="icon {{ ICO "link" }}"></span>
          <a target="_blank" href="{{ url }}">{{ URL url }}</a>
        </span>
      {{/if}}
      {{#if email}}
        <div class="email">
          <span class="url grid-column-flow">
            <span class="icon {{ ICO "mail" }}"></span>
            <a href="mailto:{{ email }}">{{ email }}</a>
          </span>
        </div>
      {{/if}}
      {{#if phone}}
        <div class="phone">
          <span class="url grid-column-flow">
            <span class="icon {{ ICO "phone" }}"></span>
            <a href="tel:{{ phone }}">{{ phone }}</a>
          </span>
        </div>
      {{/if}}
    </div>
    {{#if profiles.length}}
      <div id="profiles" class="grid-column-flow">
        {{#each profiles}}
          <div class="item">
            {{#if network}}
              <div class="username">
                {{#if url}}
                  <span class="url grid-column-flow">
                    <span class="icon {{ ICO network }}"></span>
                    <a target="_blank" href="{{ url }}">{{ username }}</a>
                  </span>
                {{ else }}
                  <span>{{ username }}</span>
                {{/if}}
              </div>
            {{/if}}
          </div>
        {{/each}}
      </div>
    {{/if}}
  </section>
  {{#if summary}}
    {{> components/hr.hbs size="lg" }}
    <section class="section">
      <header>
        <h2 class="section-title grid-column-flow">
          <span class="icon {{ ICO "summary" }}"></span>
          {{ TITLE "summary" }}
        </h2>
      </header>
      <section class="main-summary m-auto blur-card">
        {{{ summary }}}
      </section>
    </section>
  {{/if}}
</article>
{{/basics}}
