{{#if education.length}}
  <section class="section no-break-inside auto-break-before">
    {{> components/hr.hbs size="md" }}
    <header class="section-header">
      <h2 class='section-title grid-column-flow'>
        <span class="icon {{ ICO "education" }}"></span>
        {{ TITLE "educations" }}
        <span class="item-count">({{ education.length }})</span>
      </h2>
    </header>
    <section id="education">
      {{#each education}}
        <section class="education-item">
          <header class="item-header">
            <div>
              {{#if studyType}}
                <div class="studyType text-title-font">{{ studyType }}</div>
              {{/if}}
              {{#if institution}}
                <div class="institution text-title-font">{{ institution }}</div>
              {{/if}}
              {{#if area}}
                <div class="area">({{ area }})</div>
              {{/if}}
          {{#if summary}}
            <div class="summary">{{ summary }}</div>
          {{/if}}
            </div>
            <div class="date">
              {{#if startDate}}
                <span class="startDate">{{ Y startDate }}</span>
              {{/if}}
              {{#if endDate}}
                <span class="endDate">- {{ Y endDate }}</span>
              {{ else }}
                <span class="endDate">- Current</span>
              {{/if}}
            </div>
          </header>
          {{#location}}
          <span class="location">
            {{#if city}}
              <span class="city">{{ city }}</span>
            {{/if}}
            {{#if countryCode}}
              <span class="countryCode">({{ countryCode }})</span>
            {{/if}}
            {{#if region}}
              <span class="region">{{ region }}</span>
            {{/if}}
          </span>
        {{/location}}
        {{#if courses.length}}
          <ul class="courses">
            {{#each courses}}
              <li>{{.}}</li>
            {{/each}}
          </ul>
        {{/if}}
        <div class="item">
          {{#if gpa}}
            <div class='gpa'>
              <strong>Grade:</strong> <span>{{ gpa }}</span>
            </div>
          {{/if}}
        </div>
      </section>
    {{/each}}
  </section>
</section>
{{/if}}
