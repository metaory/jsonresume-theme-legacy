{{#if awards.length}}
  {{> components/hr.hbs size="md" }}
  <section class="section">
    <header class="section-header">
      <h2 class="section-title grid-column-flow">
        <span class="icon {{ ICO "award" }}"></span>
        {{ TITLE "awards" }}
      </h2>
    </header>
    <section id="awards">
      {{#each awards}}
        <section class="award-item">
          <header class="item-header">
            <div>
              {{#if title}}
                <div class="title content-title text-title-font">{{ title }}</div>
              {{/if}}
              {{#if awarder}}
                <div class="awarder content-title text-title-font">{{ awarder }}</div>
              {{/if}}
            </div>
            {{#if date}}
              <div class="date content-meta">{{ Y date }}</div>
            {{/if}}
          </header>
          <div class="item">
            {{#if summary}}
              <div class="summary">{{ summary }}</div>
            {{/if}}
          </div>
        </section>
      {{/each}}
    </section>
  </section>
{{/if}}
