{
  "name": "jsonresume-theme-legacy",
  "version": "7.0.5",
  "description": "✱ Modern Vite-based JSONResume theme with Iconify integration, customizable colors, and PDF export capabilities",
  "author": "metaory <metaory@gmail.com>",
  "bugs": "https://github.com/metaory/jsonresume-theme-legacy/issues",
  "homepage": "https://github.com/metaory/jsonresume-theme-legacy#readme",
  "repository": "git+https://github.com/metaory/jsonresume-theme-legacy.git",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev --host",
    "optimize:images": "bash .github/scripts/optimize-images.sh",
    "optimize:pdf": "bash .github/scripts/optimize-pdf.sh",
    "build": "npm run build:private",
    "build:vite": "vite build",
    "build:screenshot": "chromium --headless --disable-gpu --virtual-time-budget=2000 --screenshot --clip=0,0,780,790 http://localhost:5173",
    "build:sample": "chromium --headless --disable-gpu --no-pdf-header-footer --print-to-pdf=out/sample.pdf --virtual-time-budget=9000 http://localhost:5173",
    "build:private": "chromium --headless --disable-gpu --no-pdf-header-footer --print-to-pdf=out/private.pdf --print-to-pdf-no-background --virtual-time-budget=3000 http://localhost:5173/private",
    "deploy": "vite build --base=/jsonresume-theme-legacy",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@iconify/json": "~2.2.347",
    "@iconify/tailwind": "~1.2.0",
    "@vituum/vite-plugin-handlebars": "1.x",
    "@vituum/vite-plugin-tailwindcss": "1.x",
    "autoprefixer": "~10.4.21",
    "postcss": "~8.5.4",
    "tailwindcss": "~4.1.8",
    "vite": "~6.4.2",
    "vituum": "~1.2.0"
  },
  "dependencies": {
    "@fontsource-variable/rubik": "^5.2.6",
    "@fontsource/blackout-midnight": "^5.2.5",
    "@fontsource/blackout-two-am": "^5.2.5",
    "@fontsource/bungee": "^5.2.6",
    "@fontsource/bungee-hairline": "^5.2.6",
    "@fontsource/bungee-shade": "^5.2.6",
    "@fontsource/monaspace-radon": "^5.2.5",
    "@fontsource/rubik": "^5.2.6"
  }
}
